{
  "info": {
    "name": "WMS - location-bin-service",
    "description": "Increment 1 :: Locations and Bins. Run the requests top to bottom - the create requests save locationId / binId into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "warehouseId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "locationId", "value": "" },
    { "key": "binId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Create location",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('locationId', body.id);",
              "pm.test('code is uppercased', () => pm.expect(body.locationCode).to.eql('A1-RACK-01'));",
              "pm.test('defaults to ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/locations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "locations"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"locationCode\": \"a1-rack-01\",\n  \"name\": \"Aisle 1 Rack 1\",\n  \"type\": \"RACK\",\n  \"status\": \"ACTIVE\"\n}"
        }
      }
    },
    {
      "name": "02 Create location - duplicate code (expect 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('LOCATION_CODE_ALREADY_EXISTS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/locations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "locations"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"locationCode\": \"A1-RACK-01\",\n  \"name\": \"Duplicate\",\n  \"type\": \"RACK\"\n}"
        }
      }
    },
    {
      "name": "03 Create location - invalid payload (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('field errors present', () => pm.expect(pm.response.json().fieldErrors).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/locations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "locations"] },
        "body": { "mode": "raw", "raw": "{\n  \"locationCode\": \"\",\n  \"name\": \"\"\n}" }
      }
    },
    {
      "name": "04 Get location by id",
      "event": [
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}"]
        }
      }
    },
    {
      "name": "05 List locations of warehouse",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/warehouses/{{warehouseId}}/locations?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "warehouses", "{{warehouseId}}", "locations"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" },
            { "key": "status", "value": "ACTIVE", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "06 Create bin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('binId', body.id);",
              "pm.test('is a valid put-away target', () => pm.expect(body.acceptsPutAway).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/bins", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bins"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locationId\": \"{{locationId}}\",\n  \"binCode\": \"BIN-001\",\n  \"capacity\": 120,\n  \"status\": \"AVAILABLE\"\n}"
        }
      }
    },
    {
      "name": "07 Create bin - zero capacity (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/bins", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bins"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locationId\": \"{{locationId}}\",\n  \"binCode\": \"BIN-BAD\",\n  \"capacity\": 0\n}"
        }
      }
    },
    {
      "name": "08 Get bin by id (put-away validation call)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/bins/{{binId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "bins", "{{binId}}"]
        }
      }
    },
    {
      "name": "09 List bins of location",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/bins?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "bins"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" },
            { "key": "status", "value": "AVAILABLE", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "10 Update bin capacity",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bins/{{binId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "bins", "{{binId}}"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"capacity\": 200\n}" }
      }
    },
    {
      "name": "11 Block bin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('no longer a put-away target', () => pm.expect(pm.response.json().acceptsPutAway).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bins/{{binId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "bins", "{{binId}}", "status"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"BLOCKED\"\n}" }
      }
    },
    {
      "name": "12 Deactivate location with live bins (expect 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('LOCATION_HAS_ACTIVE_BINS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "status"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}" }
      }
    },
    {
      "name": "13 Get unknown bin (expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('BIN_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/bins/99999999-9999-9999-9999-999999999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "bins", "99999999-9999-9999-9999-999999999999"]
        }
      }
    }
  ]
}
