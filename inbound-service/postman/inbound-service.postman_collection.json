{
  "info": {
    "name": "WMS - inbound-service",
    "description": "Increment 1 :: Goods Receipt and receipt lines. Run top to bottom - ids are captured into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083" },
    { "key": "warehouseId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "receiptId", "value": "" },
    { "key": "lineId", "value": "" },
    { "key": "draftReceiptId", "value": "" },
    { "key": "draftLineId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Create receipt (stock counted in immediately)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('receiptId', b.id);",
              "pm.collectionVariables.set('lineId', b.lines[0].id);",
              "pm.test('receipt number generated', () => pm.expect(b.receiptNumber).to.match(/^GR-\\d{6}$/));",
              "pm.test('status RECEIVED', () => pm.expect(b.status).to.eql('RECEIVED'));",
              "pm.test('line eligible for put-away', () => pm.expect(b.lines[0].eligibleForPutAway).to.be.true);",
              "pm.test('remaining = received', () => pm.expect(Number(b.lines[0].remainingQuantity)).to.eql(100));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/goods-receipts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goods-receipts"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"referenceType\": \"PURCHASE_ORDER\",\n  \"referenceId\": \"PO-10001\",\n  \"lines\": [\n    {\n      \"skuId\": \"SKU-1001\",\n      \"expectedQuantity\": 100,\n      \"receivedQuantity\": 100,\n      \"uom\": \"EA\"\n    },\n    {\n      \"skuId\": \"SKU-1002\",\n      \"expectedQuantity\": 50,\n      \"receivedQuantity\": 48,\n      \"uom\": \"EA\",\n      \"batchNumber\": \"BATCH-A7\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "02 Get receipt by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('discrepancy flagged (48 of 50)', () => pm.expect(pm.response.json().hasDiscrepancy).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipts/{{receiptId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipts", "{{receiptId}}"]
        }
      }
    },
    {
      "name": "03 List receipts for warehouse",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/warehouses/{{warehouseId}}/goods-receipts?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "warehouses", "{{warehouseId}}", "goods-receipts"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" },
            { "key": "status", "value": "RECEIVED", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "04 Put-away work queue",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('two lines waiting', () => pm.expect(pm.response.json().length).to.be.at.least(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/warehouses/{{warehouseId}}/goods-receipt-lines/awaiting-put-away",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "warehouses", "{{warehouseId}}", "goods-receipt-lines", "awaiting-put-away"]
        }
      }
    },
    {
      "name": "05 Put away 60 of 100 (partial)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('status PARTIALLY_PUT_AWAY', () => pm.expect(b.status).to.eql('PARTIALLY_PUT_AWAY'));",
              "pm.test('40 remaining', () => pm.expect(Number(b.remainingQuantity)).to.eql(40));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipt-lines/{{lineId}}/put-away-allocation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipt-lines", "{{lineId}}", "put-away-allocation"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 60\n}" }
      }
    },
    {
      "name": "06 Over-allocate put-away (expect 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('PUT_AWAY_EXCEEDS_RECEIVED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipt-lines/{{lineId}}/put-away-allocation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipt-lines", "{{lineId}}", "put-away-allocation"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 50\n}" }
      }
    },
    {
      "name": "07 Put away the remaining 40",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('status PUT_AWAY', () => pm.expect(b.status).to.eql('PUT_AWAY'));",
              "pm.test('nothing remaining', () => pm.expect(Number(b.remainingQuantity)).to.eql(0));",
              "pm.test('no longer eligible', () => pm.expect(b.eligibleForPutAway).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipt-lines/{{lineId}}/put-away-allocation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipt-lines", "{{lineId}}", "put-away-allocation"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 40\n}" }
      }
    },
    {
      "name": "08 Negative quantity (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('field errors present', () => pm.expect(pm.response.json().fieldErrors).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipt-lines/{{lineId}}/put-away-allocation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipt-lines", "{{lineId}}", "put-away-allocation"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": -5\n}" }
      }
    },
    {
      "name": "09 Create receipt with no lines (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/goods-receipts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goods-receipts"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"referenceType\": \"PURCHASE_ORDER\",\n  \"referenceId\": \"PO-EMPTY\",\n  \"lines\": []\n}"
        }
      }
    },
    {
      "name": "10 Create DRAFT receipt (count stock later)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('draftReceiptId', b.id);",
              "pm.collectionVariables.set('draftLineId', b.lines[0].id);",
              "pm.test('status DRAFT', () => pm.expect(b.status).to.eql('DRAFT'));",
              "pm.test('line PENDING', () => pm.expect(b.lines[0].status).to.eql('PENDING'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/goods-receipts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goods-receipts"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"referenceType\": \"PURCHASE_ORDER\",\n  \"referenceId\": \"PO-10002\",\n  \"lines\": [\n    {\n      \"skuId\": \"SKU-2001\",\n      \"expectedQuantity\": 75,\n      \"uom\": \"EA\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "11 Count the draft line in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('receipt now RECEIVED', () => pm.expect(b.status).to.eql('RECEIVED'));",
              "pm.test('receivedAt stamped', () => pm.expect(b.receivedAt).to.not.be.null);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipts/{{draftReceiptId}}/lines/{{draftLineId}}/receive",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipts", "{{draftReceiptId}}", "lines", "{{draftLineId}}", "receive"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 75\n}" }
      }
    },
    {
      "name": "12 Cancel a receipt with stock already put away (expect 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('RECEIPT_PARTIALLY_PUT_AWAY'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipts/{{receiptId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipts", "{{receiptId}}", "cancel"]
        }
      }
    },
    {
      "name": "13 Get unknown receipt (expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('RECEIPT_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipts/99999999-9999-9999-9999-999999999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipts", "99999999-9999-9999-9999-999999999999"]
        }
      }
    }
  ]
}
